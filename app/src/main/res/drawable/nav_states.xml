<selector xmlns:android="http://schemas.android.com/apk/res/android">
<item android:state_focused="true"><shape><solid android:color="@color/surface_hi"/><stroke android:width="3dp" android:color="@color/accent"/><corners android:radius="12dp"/></shape></item>
<item android:state_pressed="true"><shape><solid android:color="@color/surface_hi"/><stroke android:width="1dp" android:color="@color/accent"/><corners android:radius="12dp"/></shape></item>
<item android:state_selected="true"><shape><solid android:color="@color/surface_hi"/><corners android:radius="12dp"/></shape></item>
<item><shape><solid android:color="@android:color/transparent"/><corners android:radius="12dp"/></shape></item>
</selector>