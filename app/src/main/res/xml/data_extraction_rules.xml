<?xml version="1.0" encoding="utf-8"?>
<!-- Pairing identity + SDK token never leave this device: no cloud backup
     (allowBackup=false) and no device-to-device transfer either. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
